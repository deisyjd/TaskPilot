generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String   @default("#8B5CF6")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       CompanyMembership[]
  projects          Project[]
  tasks             Task[]
  historyEvents     HistoryEvent[]
  notes             Note[]
  conversations     Conversation[]
  reminders         Reminder[]
  lastActiveForUser User[]              @relation("UserLastActiveCompany")
  apiTokens         ApiToken[]

  @@map("companies")
}

model CompanyMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_memberships")
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  password            String
  role                String
  userRole            String   @default("member")
  initials            String
  color               String   @default("bg-violet-500")
  avatarUrl           String?  @db.Text
  status              String   @default("active")
  dailyDigestEmail    Boolean  @default(false)
  taskAssignedEmail   Boolean  @default(false)
  lastActiveCompanyId String?
  lastActiveCompany   Company? @relation("UserLastActiveCompany", fields: [lastActiveCompanyId], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships              CompanyMembership[]
  projectMemberships       ProjectMember[]
  taskAssignments          TaskAssignee[]
  messages                 Message[]
  conversationParticipants ConversationParticipant[]
  createdProjects          Project[]                  @relation("ProjectCreator")
  taggedChecklistItems     ChecklistItem[]
  assignedReminders        Reminder[]
  createdNotes             Note[]                     @relation("NoteCreator")
  noteShares               NoteShare[]
  favoriteProjects         ProjectFavorite[]
  apiTokens                ApiToken[]
  oauthTokens              OAuthToken[]

  @@map("users")
}

// Tokens de acceso de máquina (PAT) para clientes headless como el servidor
// MCP. Se guarda solo el hash SHA-256; el token en claro se muestra una única
// vez al crearlo. Va atado a una empresa: la sesión derivada usa ese company
// y el rol vigente del usuario en ella.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_tokens")
}

// ─── OAuth 2.1 para conectores MCP (Claude Desktop/Web) ─────────────
// Servidor OAuth mínimo (authorization code + PKCE + registro dinámico) que
// convive con los PAT (tp_live_): es un camino de auth alterno para /api/mcp.
// El acceso actúa sobre la empresa ACTIVA del usuario (no se fija aquí).

model OAuthClient {
  id           String   @id @default(cuid()) // client_id
  clientSecret String? // clientes públicos (Claude) usan PKCE, sin secret
  name         String
  redirectUris String   @db.Text // JSON array de URIs permitidas
  createdAt    DateTime @default(now())

  @@map("oauth_clients")
}

model OAuthAuthCode {
  code                String   @id // código de autorización (aleatorio)
  clientId            String
  userId              String
  redirectUri         String   @db.Text
  codeChallenge       String
  codeChallengeMethod String   @default("S256")
  scope               String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@map("oauth_auth_codes")
}

model OAuthToken {
  id               String    @id @default(cuid())
  accessTokenHash  String    @unique
  refreshTokenHash String?   @unique
  clientId         String
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope            String?
  expiresAt        DateTime // expiración del access token
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@map("oauth_tokens")
}

model Project {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  description   String?  @db.Text
  color         String   @default("#8B5CF6")
  status        String   @default("active")
  coverImageUrl String?  @db.Text
  logoUrl       String?  @db.Text
  attachments   Json?
  links         Json?
  createdById   String?
  createdBy     User?    @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tasks     Task[]
  notes     Note[]
  members   ProjectMember[]
  reminders Reminder[]
  favorites ProjectFavorite[]

  @@unique([companyId, name])
  @@map("projects")
}

// "Destacado" en el sidebar es una preferencia por usuario, no un flag
// global del proyecto — lo que yo marco como destacado no debe aparecer
// en el sidebar de otra persona de la misma empresa.
model ProjectFavorite {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_favorites")
}

model Task {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  status      String   @default("pending")
  startDate   String?
  dueDate     String
  priority    String   @default("medium")
  type        String   @default("other")
  tags        Json     @default("[]")
  coverImageUrl String? @db.Text
  attachments Json?
  links       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Recurrencia: la tarea original (parentTaskId = null, recurrence definido)
  // es la plantilla; cada ocurrencia generada apunta a ella.
  recurrence         String?
  recurrenceInterval Int?
  recurrenceUntil    String?
  parentTaskId       String?
  parentTask         Task?   @relation("TaskRecurrence", fields: [parentTaskId], references: [id], onDelete: SetNull)
  occurrences        Task[]  @relation("TaskRecurrence")

  checklist ChecklistItem[]
  comments  Comment[]
  assignees TaskAssignee[]

  // Unicidad de ocurrencias de recurrencia: dos generaciones concurrentes no
  // pueden crear la misma ocurrencia (mismo parentTaskId + dueDate). Las
  // plantillas (parentTaskId = null) no chocan: Postgres trata cada NULL como
  // distinto en un índice único.
  @@unique([parentTaskId, dueDate])
  @@index([companyId])
  // El listado principal filtra por companyId y ordena por createdAt / filtra
  // por status: estos compuestos evitan seq-scan + sort en memoria.
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([projectId])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("editor") // 'editor' | 'viewer' — viewer solo puede ver esta tarea, no editarla
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
  @@map("task_assignees")
}

model ChecklistItem {
  id         String  @id @default(cuid())
  taskId     String
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text       String
  done       Boolean @default(false)
  dueDate    String?
  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  // Se leen/borran por taskId en cada GET del listado (include) — sin índice
  // era un seq-scan por cada tarea. assigneeId se indexa por el onDelete.
  @@index([taskId])
  @@index([assigneeId])
  @@map("checklist_items")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    String
  text      String   @db.Text
  createdAt DateTime @default(now())

  // Se leen por taskId en cada GET del listado (include) — sin índice era un
  // seq-scan por cada tarea.
  @@index([taskId])
  @@map("comments")
}

model HistoryEvent {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        String
  taskId      String?
  taskTitle   String?
  project     String?
  description String   @db.Text
  user        String
  timestamp   DateTime @default(now())
  meta        Json?

  // El historial se filtra por companyId y ordena por timestamp desc: el
  // compuesto sirve ambos (supera al índice simple de companyId).
  @@index([companyId, timestamp])
  @@map("history_events")
}

model Conversation {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String?
  type          String   @default("direct")
  coverImageUrl String?  @db.Text
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([companyId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  attachments    Json?
  links          Json?
  createdAt      DateTime     @default(now())

  // El historial de una conversación se ordena por createdAt: el compuesto
  // sirve tanto el filtro por conversationId como el orden (supera al simple).
  @@index([conversationId, createdAt])
  @@map("messages")
}

model Note {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  content       String?  @db.Text
  color         String?
  createdBy     String?
  createdById   String?
  createdByUser User?    @relation("NoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shares NoteShare[]

  @@index([companyId])
  @@index([projectId])
  @@map("notes")
}

// Notas sin createdById (creadas antes de esta funcionalidad) se
// mantienen visibles/editables para todo el proyecto como antes —
// la privacidad estricta solo aplica a notas con dueño identificado.
// Ni siquiera el admin puede ver una nota privada no compartida.
model NoteShare {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("viewer") // 'viewer' | 'editor'
  createdAt DateTime @default(now())

  @@unique([noteId, userId])
  @@index([noteId])
  @@index([userId])
  @@map("note_shares")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("editor") // 'editor' | 'viewer' — viewer solo puede ver el proyecto, no editarlo
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Reminder {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  dueDate    String
  dueTime    String?
  done       Boolean  @default(false)
  assigneeId String?
  assignee   User?    @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy  String?
  createdAt  DateTime @default(now())

  // Recurrencia: el recordatorio original (parentReminderId = null,
  // recurrence definido) es la plantilla; cada ocurrencia generada apunta
  // a ella. Mismo patrón que la recurrencia de tareas (src/lib/recurrence.ts).
  recurrence         String?
  recurrenceInterval Int?
  recurrenceUntil    String?
  parentReminderId   String?
  parentReminder     Reminder?  @relation("ReminderRecurrence", fields: [parentReminderId], references: [id], onDelete: SetNull)
  occurrences        Reminder[] @relation("ReminderRecurrence")

  // Mismo blindaje de recurrencia que Task: ocurrencias únicas por
  // (parentReminderId, dueDate). El listado ordena por dueDate.
  @@unique([parentReminderId, dueDate])
  @@index([companyId])
  @@index([companyId, dueDate])
  @@index([projectId])
  @@index([parentReminderId])
  @@map("reminders")
}

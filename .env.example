# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://taskpilot:password@localhost:5432/taskpilot"

# JWT — use a long random string in production
JWT_SECRET="replace-with-a-secure-random-secret"

# Contraseña temporal para los usuarios creados por el seed inicial de
# producción (solo se usa la primera vez, si la base de datos no tiene
# usuarios todavía). Usa un valor fuerte y único por despliegue — nunca
# el mismo que en prisma/seed.ts (ese es solo para desarrollo local).
# Cambien la contraseña desde el panel apenas puedan entrar.
SEED_USER_PASSWORD="replace-with-a-strong-temporary-password"

# Next.js
NODE_ENV="production"

# SMTP — resumen diario por correo (lun-vie 7am hora Colombia)
SMTP_HOST="mail.tudominio.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notificaciones@tudominio.com"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="Wipli <notificaciones@tudominio.com>"

# URL pública de la app. Se usa en el botón "Abrir Wipli" del correo y como
# base del redirect_uri de Google OAuth (ver abajo).
APP_URL="https://wipli.adminainoa.com"

# Carpeta donde se guardan los archivos subidos (imágenes, adjuntos). Debe
# apuntar a un volumen persistente. Por defecto es <cwd>/uploads, que en el
# contenedor es /app/uploads — monta ahí el volumen en Dokploy. Normalmente no
# hace falta cambiar esto.
# UPLOADS_DIR="/app/uploads"

# Redis (opcional) — caché de lecturas pesadas y, a futuro, pub/sub para tiempo
# real. Si no se define, la app funciona igual (sin caché). Ej:
# REDIS_URL="redis://default:password@redis:6379"
REDIS_URL=""

# Google OAuth — inicio de sesión con Google.
# 1) En Google Cloud Console crea un "OAuth 2.0 Client ID" de tipo "Web application".
# 2) Registra estas URIs de redirección autorizadas (deben coincidir EXACTAMENTE):
#      {APP_URL}/api/auth/google/callback         (producción)
#      http://localhost:3000/api/auth/google/callback   (desarrollo)
# 3) Copia el Client ID y el Client Secret aquí.
# Solo pueden entrar correos que ya existan como usuarios activos en la app.
GOOGLE_CLIENT_ID="replace-with-your-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-your-google-client-secret"
